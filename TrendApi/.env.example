# Copy this file to .env (same folder) and fill in the values. .env is git-ignored.
# On Azure, set these as App Settings (or Key Vault references) instead of using a file.

# NASA Earthdata user token, used to stream data from NASA's cloud.
# Create one at https://urs.earthdata.nasa.gov/users/tokens (Generate Token).
# Tokens expire after 60 days; /health shows the expiry date.
EARTHDATA_TOKEN=

# Claude key for AI explanations (optional).
# Create a key in the Claude Console (https://platform.claude.com) under API keys.
ANTHROPIC_API_KEY=
